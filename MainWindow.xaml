<Window x:Class="RoomNavigationAlgorithm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoomNavigationAlgorithm"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" WindowState="Maximized">
    <Window.Resources>
        <Style x:Key="GameButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#1E1E1E">

        <StackPanel x:Name="MainMenuPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="475" Visibility="Visible">
            <TextBlock Text="Randomizer and Validation Engine" FontSize="28" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,5" Foreground="White"/>
            <TextBlock Text="State Dependent Traversal and Constraint Solver" FontSize="14" Foreground="White" TextAlignment="Center" Margin="0,0,0,30"/>

            <Button Content="Project Purpose" Height="30" Margin="0,0,0,10" Click="PurposeButton_Click" Background="#E0E0E0"/>
            <Button Content="Mechanics, Rules and Generation Modes" Height="30" Margin="0,0,0,20" Click="RulesButton_Click" Background="#E0E0E0"/>

            <TextBlock Text="Generation Seed (Numbers Only):" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="White"/>
            <TextBox x:Name="SeedTextBox" Height="25" Margin="0,0,0,15" PreviewTextInput="SeedTextBox_PreviewTextInput" MaxLength="10"/>

            <TextBlock Text="Grid Size:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="White"/>
            <ComboBox x:Name="SizeComboBox" Height="25" Margin="0,0,0,15" SelectedIndex="0">
                <ComboBoxItem Content="Small (7x7)"/>
                <ComboBoxItem Content="Medium (11x11)"/>
                <ComboBoxItem Content="Large (15x15)"/>
            </ComboBox>

            <TextBlock Text="Generation Algorithm:" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="White"/>
            <ComboBox x:Name="ModeComboBox" Height="25" Margin="0,0,0,30" SelectedIndex="0">
                <ComboBoxItem Content="Mode A: Zones (100% Solvable)"/>
                <ComboBoxItem Content="Mode B: Random Scramble + Validation"/>
                <ComboBoxItem Content="Mode C: Chaos (No Logic)"/>
            </ComboBox>

            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Width="300">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Button x:Name="BtnGenerate" Content="GENERATE MAP" Width="180" Height="40" FontSize="16" FontWeight="Bold" Background="#4CAF50" Foreground="White" Click="GenerateButton_Click"/>
                    <Button x:Name="BtnCancel" Content="CANCEL" Width="100" Height="40" FontSize="16" FontWeight="Bold" Background="#F44336" Foreground="White" Margin="10,0,0,0" Visibility="Collapsed" Click="CancelButton_Click"/>
                </StackPanel>

                <Button x:Name="BtnMonteCarlo" Content="RUN MONTE CARLO (10k SEEDS)" Height="40" Background="#673AB7" Foreground="White" FontWeight="Bold" Click="BtnMonteCarlo_Click"/>

                <TextBlock x:Name="TxtMonteCarloProgress" Text="Checked: 0 / 10000" FontSize="14" Foreground="Goldenrod" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>

            </StackPanel>

            <TextBlock x:Name="TxtGenerateStatus" Text="" Foreground="Gray" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Margin="0,15,0,0"/>
        </StackPanel>

        <Grid x:Name="MonteCarloPanel" Background="#E6121212" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="#1E1E1E" BorderBrush="#673AB7" BorderThickness="3" CornerRadius="10" Width="400" Height="500" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="MONTE CARLO RESULTS" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Grid.Row="0"/>
                    <TextBlock x:Name="TxtMonteCarloSettings" Text="Mode: A | Grid: 11x11" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,10" Grid.Row="1"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10" Grid.Row="2">
                        <TextBlock x:Name="TxtMonteCarloPass" Text="Passed: 0" Foreground="LimeGreen" FontWeight="Bold" Margin="0,0,15,0"/>
                        <TextBlock x:Name="TxtMonteCarloFail" Text="Failed: 0" Foreground="Red" FontWeight="Bold" Margin="0,0,15,0"/>
                        <TextBlock x:Name="TxtMonteCarloRate" Text="Win Rate: 0%" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>

                    <ListBox x:Name="ListMonteCarloProof" Background="#2D2D30" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Row="3" Padding="5"/>

                    <Button Content="CLOSE RESULTS" Height="35" Background="#4CAF50" Foreground="White" FontWeight="Bold" Margin="0,15,0,0" Grid.Row="4" Click="BtnCloseMonteCarlo_Click"/>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="GamePanel" Visibility="Collapsed" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="#252526" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,5">
                    <Button x:Name="BtnMainMenu" Content="← Menu" Width="70" Height="30" Margin="0,0,15,0" Click="ReturnToMenu_Click"/>
                    <TextBlock x:Name="SeedDisplayBlock" Text="Seed: 12345" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/>
                    <Button Content="Copy" Width="40" Height="25" Margin="0,0,15,0" Click="CopySeed_Click"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,15,0">
                        <TextBlock x:Name="ModeDisplayBlock" Text="Mode: Chaos" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DensityDisplayBlock" Text="Items: --% | Locks: --%" Foreground="#AAAAAA" FontSize="11"/>
                    </StackPanel>
                    <Button Content="Reset Run" Width="80" Height="30" Margin="0,0,10,0" Background="#FF9800" Foreground="White" FontWeight="Bold" Style="{StaticResource GameButtonStyle}" Click="ResetSeed_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Verify Seed" Width="90" Height="30" Margin="0,0,10,0" Background="#9C27B0" Foreground="White" FontWeight="Bold" Style="{StaticResource GameButtonStyle}" Click="VerifySeed_Click"/>
                    <TextBlock x:Name="SeedStatusText" Text="?" Foreground="LightGray" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="0,0,15,0"/>
                    <Button x:Name="BtnSeedSpoiler" Content="Spoiler Log" Width="90" Height="30" Background="#444" Foreground="White" Style="{StaticResource GameButtonStyle}" Click="SeedSpoiler_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,5,20,5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                        <Button Content="Check State" Width="90" Height="25" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" FontWeight="Bold" Style="{StaticResource GameButtonStyle}" Click="VerifyCurrent_Click"/>
                        <TextBlock x:Name="CurrentStatusText" Text="?" Foreground="LightGray" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Width="100"/>
                        <Button x:Name="BtnCurrentSpoiler" Content="Current Log" Width="90" Height="25" Background="#444" Foreground="White" Style="{StaticResource GameButtonStyle}" Click="CurrentSpoiler_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,20,0" Background="White" Name="RoomPanel">
                <TextBlock x:Name="CoordsDisplay" Text="Current Room: [0, 0]" FontSize="18" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" Margin="0,20,0,0"/>

                <Button x:Name="BtnNorth" Style="{StaticResource GameButtonStyle}" Content="NORTH&#x0a;(Locked: Red)" Width="100" Height="60" Foreground="Black" VerticalAlignment="Top" Margin="0,80,0,0" Click="Door_Click"/>
                <Button x:Name="BtnSouth" Style="{StaticResource GameButtonStyle}" Content="SOUTH&#x0a;(Open)" Width="100" Height="60" Foreground="Black" VerticalAlignment="Bottom" Margin="0,0,0,80" Click="Door_Click"/>
                <Button x:Name="BtnWest" Style="{StaticResource GameButtonStyle}" Content="WEST&#x0a;(Wall)" Width="100" Height="60" Foreground="Black" HorizontalAlignment="Left" Margin="80,0,0,0" Click="Door_Click"/>
                <Button x:Name="BtnEast" Style="{StaticResource GameButtonStyle}" Content="EAST&#x0a;(Locked: Silver)" Width="100" Height="60" Foreground="Black" HorizontalAlignment="Right" Margin="0,0,80,0" Click="Door_Click"/>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0">

                    <Border Background="#EEEEEE" BorderBrush="#999999" BorderThickness="1" Padding="10" Margin="0,0,0,15" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="INVENTORY (Select to equip)" FontWeight="Bold" FontSize="14" Foreground="Black" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <WrapPanel MaxWidth="300" HorizontalAlignment="Center">
                                <RadioButton x:Name="RadRed" Content="Red: 0" Margin="5" Tag="Red" Foreground="Black" FontWeight="SemiBold" Click="Inventory_Select"/>
                                <RadioButton x:Name="RadBlue" Content="Blue: 0" Margin="5" Tag="Blue" Foreground="Black" FontWeight="SemiBold" Click="Inventory_Select"/>
                                <RadioButton x:Name="RadGreen" Content="Green: 0" Margin="5" Tag="Green" Foreground="Black" FontWeight="SemiBold" Click="Inventory_Select"/>
                                <RadioButton x:Name="RadYellow" Content="Yellow: 0" Margin="5" Tag="Yellow" Foreground="Black" FontWeight="SemiBold" Click="Inventory_Select"/>
                                <RadioButton x:Name="RadSilver" Content="Silver: 0" Margin="5" Tag="Silver" Foreground="Black" FontWeight="SemiBold" Click="Inventory_Select"/>
                                <RadioButton x:Name="RadLockpick" Content="Lockpicks: 0" Margin="5" Tag="Lockpick" Foreground="Black" FontWeight="SemiBold" Click="Inventory_Select"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Button x:Name="ItemButton" Content="Pick up Item!" FontSize="16" Foreground="Black" Background="#FF9800" FontWeight="Bold" Width="200" Height="40" HorizontalAlignment="Center" Visibility="Collapsed" Click="ItemButton_Click"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Grid.Column="1">
                <Border Background="#222" BorderBrush="#555" BorderThickness="2" Height="250" Margin="0,0,0,10" CornerRadius="5" ClipToBounds="True">
                    <Viewbox Margin="10">
                        <Canvas x:Name="MinimapCanvas" Width="100" Height="100"/>
                    </Viewbox>
                </Border>

                <Button x:Name="BtnRevealMap" Content="Reveal Map" Width="120" Height="30" Margin="0,0,0,20" Background="#333" Foreground="White" Click="BtnRevealMap_Click"/>

                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Button x:Name="BtnGenerateExplorable" Content="GEN 100% EXPLORABLE" Width="220" Height="35" Background="#4CAF50" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" Click="BtnGenerateExplorable_Click"/>
                    <Button x:Name="BtnGenerateBasicAnalytics" Content="GEN BASIC ANALYTICS" Width="220" Height="35" Background="#2196F3" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" Click="BtnGenerateBasicAnalytics_Click"/>
                    <Button x:Name="BtnGenerate100Percent" Content="GEN 100% COMPLETION" Width="220" Height="35" Background="#673AB7" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" Click="BtnGenerate100Percent_Click"/>
                    <Button x:Name="BtnViewRoutingLog" Content="VIEW LOGS" Width="220" Height="35" Background="#607D8B" Foreground="White" FontWeight="Bold" IsEnabled="False" Margin="0,0,0,10" Click="BtnViewRoutingLog_Click"/>
                    <Button x:Name="BtnCancelAnalytics" Content="CANCEL" Width="220" Height="35" Background="#F44336" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" Visibility="Collapsed" Click="BtnCancelAnalytics_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border x:Name="BadgeExplorable" Background="#333333" CornerRadius="5" Padding="10,5" Margin="0,0,10,0" Width="180">
                            <TextBlock x:Name="TxtExplorable" Text="Fully Explorable: ?" Foreground="LightGray" FontWeight="Bold" TextAlignment="Center"/>
                        </Border>
                        <Border x:Name="BadgeCompletion" Background="#333333" CornerRadius="5" Padding="10,5" Width="180">
                            <TextBlock x:Name="TxtCompletion" Text="100% Clear: ?" Foreground="LightGray" FontWeight="Bold" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
